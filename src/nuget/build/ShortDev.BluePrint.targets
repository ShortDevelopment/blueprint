<Project>

	<ItemGroup Condition="'$(EnableDefaultItems)' != 'false'">
		<Compile Update="**\*$(BluePrintExtension)$(DefaultLanguageSourceExtension)" DependentUpon="%(Filename)" SubType="Code"/>
	</ItemGroup>

	<PropertyGroup>
		<_BluePrintBuildTasksTfm Condition="'$(MSBuildRuntimeType)' == 'Core'">net11.0</_BluePrintBuildTasksTfm>
		<_BluePrintBuildTasksTfm Condition="'$(MSBuildRuntimeType)' != 'Core'">net472</_BluePrintBuildTasksTfm>
		<_BluePrintBuildTasksAssembly Condition="'$(_BluePrintBuildTasksAssembly)'==''">$([MSBuild]::Unescape($([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\tasks\$(_BluePrintBuildTasksTfm)\BluePrint.Compiler.Tasks.dll'))))</_BluePrintBuildTasksAssembly>
	</PropertyGroup>

	<UsingTask TaskName="BluePrint.Compiler.Tasks.CompileBluePrint" AssemblyFile="$(_BluePrintBuildTasksAssembly)"/>

	<PropertyGroup>
		<PrepareResourcesDependsOn>
			CompileBluePrint;
			$(PrepareResourcesDependsOn)
		</PrepareResourcesDependsOn>
	</PropertyGroup>

	<Target Name="CompileBluePrint">

		<Message Text="(in) BluePrint: '@(BluePrint)'" Condition=" '$(MSBuildTargetsVerbose)' == 'true' "/>

		<CompileBluePrint
                Inputs="@(BluePrint)"
                OutputPath="$(IntermediateOutputPath)">

			<Output ItemName="GeneratedGtkXml" TaskParameter="GeneratedFiles"/>

		</CompileBluePrint>

		<Message Text="(out) GeneratedGtkXml: '@(GeneratedGtkXml)'" Condition=" '$(MSBuildTargetsVerbose)' == 'true' "/>

		<ItemGroup>
			<EmbeddedResource Include="@(GeneratedGtkXml)"/>
		</ItemGroup>

	</Target>

</Project>
